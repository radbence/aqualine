---
const base = import.meta.env.BASE_URL + '/';

const navLinks = [
  { label: 'Főoldal', href: base, path: '/' },
  { label: 'Rólunk', href: `${base}rolunk`, path: '/rolunk' },
  { label: 'Referenciák', href: `${base}referenciak`, path: '/referenciak' },
  { label: 'Kapcsolat', href: `${base}kapcsolat`, path: '/kapcsolat' },
];

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={base} class="site-header__logo" aria-label="Aqua-Line Bau Kft. — Főoldal">
      <img src={`${base}images/aqualine.svg`} alt="Aqua-Line Bau Kft." width="200" height="38" />
    </a>

    <button
      class="site-header__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Menü megnyitása"
    >
      <span class="site-header__toggle-bar"></span>
      <span class="site-header__toggle-bar"></span>
      <span class="site-header__toggle-bar"></span>
    </button>

    <nav class="site-header__nav" id="main-nav" aria-label="Főmenü">
      <ul class="site-header__nav-list">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={`site-header__nav-link${currentPath === link.path ? ' is-active' : ''}`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open', !expanded);
  });
</script>

<style>
.site-header {
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  position: sticky;
  top: 0;
  z-index: 100;
}
.site-header__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-2) var(--space-3);
}
.site-header__logo img {
  height: 36px;
  width: auto;
}
.site-header__toggle {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: var(--space-1);
}
.site-header__toggle-bar {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--color-text);
  border-radius: 2px;
  transition: transform .2s, opacity .2s;
}
.site-header__nav {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-2) var(--space-3);
}
.site-header__nav.is-open {
  display: block;
}
.site-header__nav-list {
  list-style: none;
  margin: 0;
  padding: 0;
}
.site-header__nav-list li {
  margin-bottom: var(--space-1);
}
.site-header__nav-link {
  display: block;
  padding: var(--space-1) 0;
  text-decoration: none;
  font-family: var(--font-heading);
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--color-text);
  transition: color .15s;
}
.site-header__nav-link:hover,
.site-header__nav-link.is-active {
  color: var(--color-accent);
}

@media (min-width: 768px) {
  .site-header__toggle {
    display: none;
  }
  .site-header__nav {
    display: block;
    position: static;
    background: none;
    border: none;
    padding: 0;
  }
  .site-header__nav-list {
    display: flex;
    gap: var(--space-3);
  }
  .site-header__nav-list li {
    margin: 0;
  }
  .site-header__nav-link {
    font-size: .95rem;
  }
}
</style>
