---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import heroBg from '../assets/images/1337.jpg';
import aboutImg from '../assets/images/1212.jpg';
import aquaImg from '../assets/images/aqua3.png';

const base = import.meta.env.BASE_URL;

const imageModules = import.meta.glob<{ default: import('astro').ImageMetadata }>(
  '../assets/images/*.{jpg,png}',
);
const imageMap: Record<string, import('astro').ImageMetadata> = {};
for (const [path, loader] of Object.entries(imageModules)) {
  const filename = path.split('/').pop()!;
  imageMap[filename] = (await loader()).default;
}

const referenciak = await getCollection('referenciak');
const kiemeltek = referenciak
  .filter((r) => r.data.kiemelt)
  .sort(() => Math.random() - 0.5)
  .slice(0, 3);

function hasBody(ref: typeof referenciak[number]): boolean {
  return ref.body != null && ref.body.trim().length > 0 && !ref.body.startsWith('TODO');
}

function getCoverImage(borito: string | undefined): import('astro').ImageMetadata | undefined {
  if (!borito || borito === 'TODO') return undefined;
  const filename = borito.replace(/^.*\//, '');
  return imageMap[filename];
}

const alapitasEve = 2011;
const jelenlegiEv = new Date().getFullYear();
const eveMukodik = jelenlegiEv - alapitasEve;
const projektSzam = 250;

const szolgaltatasok = [
  {
    cim: 'Szennyvíz beruházás',
    leiras: 'Iszapkezelés',
    ikon: `${base}images/construction-icon-1-white.png`,
  },
  {
    cim: 'Vízi létesítmények',
    leiras: 'ár- és belvízvédelem, élőhely rehabilitációs munkák, mederrendezés',
    ikon: `${base}images/construction-icon-2-white.png`,
  },
  {
    cim: 'Szerkezetépítés',
    leiras: 'medencék, zsilipek, egyéb műtárgyak',
    ikon: `${base}images/construction-icon-3-white.png`,
  },
  {
    cim: 'Város rehabilitáció',
    leiras: 'út, kerékpárút, közmű rekonstrukciók',
    ikon: `${base}images/construction-icon-4-white.png`,
  },
];
---

<Base title="" description="Nagyvolumenű mélyépítési és vízügyi munkák teljeskörű kivitelezése Magyarországon. Szennyvíz beruházás, vízi létesítmények, szerkezetépítés, város rehabilitáció — 15 éves tapasztalattal.">

<!-- ===== HERO (split) ===== -->
<section class="hero-split">
  <div class="hero-split__left hero-split__left--hero">
    <Image class="hero-split__left-bg" src={heroBg} alt="" loading="eager" />
    <div class="hero-split__left-overlay"></div>
    <div class="hero-split__text">
      <h1 class="hero-split__heading">AQUA-LINE BAU</h1>
      <p class="hero-split__tagline">
        Nagyvolumenű mélyépítési és vízügyes munkák teljeskörű kivitelezése.
      </p>
      <a href={`${base}referenciak`} class="btn btn--primary">Referenciáink</a>
    </div>
  </div>

  <div class="hero-split__right">
    <div class="hero-split__services">
      <h2 class="hero-split__services-title">Szolgáltatásaink</h2>
      <ul class="hero-split__services-list">
        {szolgaltatasok.map((s) => (
          <li class="hero-split__service-item">
            <img
              src={s.ikon}
              alt=""
              class="hero-split__service-icon"
              width="40"
              height="40"
              loading="lazy"
            />
            <div>
              <strong class="hero-split__service-name">{s.cim}</strong>
              <span class="hero-split__service-desc">{s.leiras}</span>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ===== RÓLUNK TEASER ===== -->
<section class="about-teaser" id="rolunk">
  <div class="about-teaser__inner">
    <div class="about-teaser__image">
      <Image
        src={aboutImg}
        alt=""
        loading="lazy"
        class="about-teaser__img"
      />
    </div>
    <div class="about-teaser__content">
      <h2 class="about-teaser__heading">Rólunk</h2>
      <p>
        Cégünk 2011-ben alakult. Munkatársaink sok éves szakmai tapasztalata
        garantálja a sikeres és minőségi munkán alapuló együttműködést.
      </p>
      <p>
        Széleskörű, releváns szakmai tapasztalattal rendelkezünk nagy
        volumenű mélyépítési, vízügyes munkák terén, megfelelve a szigorú
        minőségi és időbeli elvárásoknak.
      </p>
      <p>
        Munkánk legnagyobb elismerése nem más, mint hogy megrendelőink
        szívesen fordulnak hozzánk ismét, ha újabb beruházásokra,
        rekonstrukciókra kerül sor.
      </p>
      <a href={`${base}rolunk`} class="btn btn--primary">Bővebben</a>
    </div>
  </div>
  <div class="stats-band">
    <div class="stats-band__item stats-band__item--amber">
      <span class="stats-band__number">{eveMukodik}</span>
      <span class="stats-band__label">Éve alapítva</span>
    </div>
    <div class="stats-band__item stats-band__item--dark">
      <span class="stats-band__number">{projektSzam}</span>
      <span class="stats-band__label">Sikeres projekt</span>
    </div>
  </div>
</section>

<!-- ===== MUNKÁINK (kiemelt projects) ===== -->
<section class="works-section" id="munkaink">
  <div class="works-section__inner">
    <h2 class="section-heading section-heading--center section-heading--underline">
      Munkáink
    </h2>
    <div class="works-grid">
      {kiemeltek.map((ref) => {
          const coverImg = getCoverImage(ref.data.borito);
          return (
        <article class="work-card">
          {coverImg && (
            <Image
              src={coverImg}
              alt={ref.data.cim}
              class="work-card__img"
              loading="lazy"
              width={300}
              height={200}
            />
          )}
          <div class="work-card__body">
            <h3 class="work-card__title">{ref.data.cim}</h3>
            {hasBody(ref) ? (
              <a href={`${base}referenciak/${ref.id}`} class="work-card__link">Tovább</a>
            ) : (
              <span class="work-card__link is-disabled" aria-disabled="true">Részletek hamarosan</span>
            )}
          </div>
        </article>
          );
      })}
    </div>
  </div>
</section>

<!-- ===== QUOTE FORM SECTION ===== -->
<section class="quote-section" id="ajanlatkeres">
  <div class="quote-section__inner">
    <div class="quote-section__form-col">
      <h2 class="quote-section__title">Kérjen árajánlatot!</h2>
      <ContactForm />
    </div>
    <div class="quote-section__contact-col">
      <h3 class="quote-section__contact-title">Elérhetőségeink</h3>
      <address class="quote-section__address">
        <p><strong>Székhely:</strong><br/>1048 Budapest, Csíksomlyó utca 2., 1. épület, D lépcsőház 1/6.</p>
        <p><strong>Telephely:</strong><br/>4031 Debrecen, Bartók Béla út 115.</p>
        <p><strong>Levelezési cím:</strong><br/>3561 Felsőzsolca, Mátyás király u. 1.</p>
      </address>
      <p class="quote-section__phone">
        <a href="tel:+36205555878">+36 (20) 5555-878</a>
      </p>
      <p class="quote-section__email">
        <a href="mailto:aqualinebau@gmail.com">aqualinebau@gmail.com</a>
      </p>
      <Image
        src={aquaImg}
        alt=""
        class="quote-section__img"
        loading="lazy"
        width={323}
        height={193}
      />
    </div>
  </div>
</section>

</Base>

<style>
/* ---------- HERO SPLIT ---------- */
.hero-split {
  display: flex;
  flex-direction: column;
}

@media (min-width: 768px) {
  .hero-split {
    flex-direction: row;
    min-height: 560px;
  }
}

.hero-split__left {
  padding: var(--space-4) var(--space-3);
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero-split__left--hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(40,40,40,0.82), rgba(40,40,40,0.9));
}
.hero-split__left-bg {
  position: absolute;
  inset: 0;
  object-fit: cover;
  z-index: 0;
}
.hero-split__left-bg :global(img) {
  width: 100%;
  height: 100%;
}
.hero-split__left-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(40,40,40,0.82), rgba(40,40,40,0.9));
  z-index: 1;
}
@media (min-width: 768px) {
  .hero-split__left {
    padding: 0 var(--space-3);
    flex: 1 1 60%;
  }
}

.hero-split__text {
  position: relative;
  z-index: 2;
  color: #fff;
  max-width: 600px;
}

.hero-split__heading {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 700;
  line-height: 1.1;
  margin: 0 0 var(--space-2);
  color: #fff;
  display: flex;
  align-items: center;
  gap: .6em;
}
.hero-split__heading::before {
  content: '';
  display: inline-block;
  flex-shrink: 0;
  width: 7px;
  height: clamp(2rem, 5vw, 3.5rem);
  background: var(--color-primary);
}

.hero-split__tagline {
  font-size: clamp(1.05rem, 2.5vw, 1.35rem);
  line-height: 1.5;
  margin: 0 0 var(--space-3);
  color: rgba(255,255,255,0.9);
}

.hero-split__right {
  background: var(--color-primary);
  padding: var(--space-4) var(--space-3);
  display: flex;
  align-items: stretch;
}
@media (min-width: 768px) {
  .hero-split__right {
    flex: 1 1 40%;
  }
}

.hero-split__services {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.hero-split__services-title {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  margin: 0 0 var(--space-3);
  color: var(--color-dark);
}

.hero-split__services-list {
  list-style: none;
  margin: 0;
  padding: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.hero-split__service-item {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
}

.hero-split__service-icon {
  flex-shrink: 0;
  margin-top: 2px;
  width: 40px;
  height: 40px;
  opacity: 0.9;
}

.hero-split__service-name {
  display: block;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 1rem;
  color: var(--color-dark);
  margin-bottom: .15rem;
}

.hero-split__service-desc {
  display: block;
  font-size: .85rem;
  color: rgba(26,26,26,0.7);
  line-height: 1.4;
}

/* ---------- BUTTONS ---------- */
.btn {
  display: inline-block;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: .9rem;
  text-decoration: none;
  border-radius: 20px;
  transition: background .2s, color .2s;
}
.btn--primary {
  background: var(--color-accent);
  color: #fff;
  padding: .75rem 2rem;
}
.btn--primary:hover {
  background: #3452b8;
  color: #fff;
}

/* ---------- STATS BAND ---------- */
.stats-band {
  display: flex;
  flex-direction: column;
}
@media (min-width: 600px) {
  .stats-band {
    flex-direction: row;
  }
}
.stats-band__item {
  flex: 1;
  text-align: center;
  padding: var(--space-4) var(--space-3);
}
.stats-band__item--amber {
  background: var(--color-primary);
  color: var(--color-dark);
}
.stats-band__item--dark {
  background: var(--color-dark);
  color: #fff;
}
.stats-band__number {
  display: block;
  font-family: var(--font-heading);
  font-size: 3.5rem;
  font-weight: 700;
  line-height: 1;
  margin-bottom: var(--space-1);
}
.stats-band__label {
  display: block;
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: .85rem;
  text-transform: uppercase;
  letter-spacing: .1em;
}

/* ---------- SECTION HEADING ---------- */
.section-heading {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 var(--space-3);
}
.section-heading--blue {
  color: var(--color-accent);
}
.section-heading--center {
  text-align: center;
}
.section-heading--underline {
  padding-bottom: var(--space-1);
  position: relative;
}
.section-heading--underline::after {
  content: '';
  display: block;
  width: 60px;
  height: 4px;
  background: var(--color-primary);
  margin: var(--space-1) auto 0;
}

/* ---------- RÓLUNK TEASER ---------- */
.about-teaser {
  background: var(--color-bg-alt);
  padding: 0;
}
.about-teaser__inner {
  display: grid;
  grid-template-columns: 45% 55%;
}
.about-teaser__image {
  position: relative;
  overflow: hidden;
  min-height: 100%;
}
.about-teaser__img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.about-teaser__image::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  z-index: 1;
  pointer-events: none;
}
.about-teaser__content {
  padding: var(--space-4) var(--space-3);
}
.about-teaser__heading {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-weight: 700;
  margin: 0 0 var(--space-3);
  color: var(--color-accent);
  display: flex;
  align-items: center;
  gap: .6em;
}
.about-teaser__heading::before {
  content: '';
  display: inline-block;
  flex-shrink: 0;
  width: 7px;
  height: 2rem;
  background: var(--color-primary);
}
.about-teaser__content p {
  margin: 0 0 var(--space-2);
  line-height: 1.8;
  font-size: .95rem;
}

@media (max-width: 767px) {
  .about-teaser__inner {
    grid-template-columns: 1fr;
  }
  .about-teaser__image {
    min-height: 250px;
  }
}

/* ---------- WORKS SECTION ---------- */
.works-section {
  padding: var(--space-4) var(--space-3);
}
.works-section__inner {
  max-width: var(--max-width);
  margin: 0 auto;
}
.works-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-3);
}
@media (min-width: 600px) {
  .works-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}
.work-card {
  background: var(--color-bg-card);
  border: 1px solid var(--color-border);
  border-radius: var(--radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.work-card__img {
  width: 100%;
  aspect-ratio: 3 / 2;
  object-fit: cover;
}
.work-card__body {
  flex: 1;
  padding: var(--space-2);
}
.work-card__title {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 600;
  color: var(--color-text);
  margin: 0 0 var(--space-2);
  line-height: 1.4;
}
.work-card__link {
  color: var(--color-accent);
  text-decoration: none;
  font-weight: 700;
  font-size: .9rem;
}
.work-card__link:hover {
  text-decoration: underline;
}
.work-card__link.is-disabled {
  color: #999;
  cursor: default;
  font-weight: 400;
  font-style: italic;
  font-size: .85rem;
}

/* ---------- QUOTE SECTION ---------- */
.quote-section {
  background: var(--color-primary);
  padding: var(--space-4) var(--space-3);
}
.quote-section__inner {
  max-width: var(--max-width);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
@media (min-width: 768px) {
  .quote-section__inner {
    flex-direction: row;
  }
  .quote-section__form-col {
    flex: 1 1 55%;
  }
  .quote-section__contact-col {
    flex: 1 1 45%;
  }
}
.quote-section__title {
  font-family: var(--font-heading);
  font-size: 1.75rem;
  font-weight: 700;
  margin: 0 0 var(--space-2);
  color: var(--color-dark);
}
.quote-section__contact-title {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 700;
  margin: 0 0 var(--space-2);
  color: var(--color-dark);
}
.quote-section__address {
  font-style: normal;
  line-height: 1.7;
  font-size: .9rem;
  color: var(--color-dark);
  margin-bottom: var(--space-2);
}
.quote-section__address p {
  margin: 0 0 var(--space-1);
}
.quote-section__phone a,
.quote-section__email a {
  color: var(--color-dark);
  text-decoration: none;
  font-weight: 600;
}
.quote-section__phone a:hover,
.quote-section__email a:hover {
  text-decoration: underline;
}
.quote-section__img {
  max-width: 280px;
  border-radius: var(--radius);
  margin-top: var(--space-2);
}
</style>
